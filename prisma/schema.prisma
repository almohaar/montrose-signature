generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  password       String
  role           Role      @default(GUEST)
  phone          String
  address        Json?
  profilePic     String?
  isActive       Boolean   @default(true)
  emailVerified  DateTime?
  isVerified     Boolean   @default(false)
  lastLogin      DateTime?
  resetToken     String?
  resetTokenExpiry DateTime?
  isDeleted      Boolean   @default(false)
  bookings       Booking[]
  reviews        Review[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Room {
  id          String    @id @default(uuid())
  name        String
  type        RoomType
  price       Int
  description String
  amenities   String[]
  images      String[]
  rating      Float     @default(0.0)
  reviews     Review[]
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  isDeleted   Boolean   @default(false)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Review {
  user      User   @relation(fields: [userId], references: [id])
  userId    String
  room      Room   @relation(fields: [roomId], references: [id])
  roomId    String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, roomId]) // composite PK
}

model Booking {
  id                  String   @id @default(uuid())
  user                User     @relation(fields: [userId], references: [id])
  userId              String
  room                Room     @relation(fields: [roomId], references: [id])
  roomId              String
  checkIn             DateTime
  checkOut            DateTime
  totalPrice          Int
  extras              String[]
  guestName           String
  guestEmail          String
  guestPhone          String
  paid                Boolean   @default(false)
  isCancelled         Boolean   @default(false)
  cancellationReason  String?
  cancellationDate    DateTime?
  status              BookingStatus @default(PENDING)
  payments            Payment[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([checkIn, roomId, checkOut])
}

model Payment {
  id         String   @id @default(uuid())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  bookingId  String
  method     PaymentMethod
  status     PaymentStatus
  amount     Int
  providerId String?
  paidAt     DateTime?
  createdAt  DateTime @default(now())
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAL
  BANK_TRANSFER
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  GUEST
  SUPER_ADMIN
}

enum RoomType {
  PRESIDENTIAL_EXEC_SUITE
  PREMIUM_EXEC_SUITE_LAGOON
  ROYAL_EXEC_SUITE_LAGOON
  TWIN_EXEC_SUITE_LAGOON
  ROYAL_EXEC_SUITE
  EXEC_SUITE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  REFUNDED
  IN_PROGRESS
  INACTIVE
  ACTIVE
  EXPIRED
  UNDER_MAINTENANCE
}
